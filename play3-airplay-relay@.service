[Unit]
Description=Legacy Sonos audio relay (%i)
Wants=network-online.target
After=network-online.target
PartOf=play3-airplay-receiver@%i.service

[Service]
User=play3-airplay
RuntimeDirectory=play3-airplay-%i
Environment=PLAY3_RUNTIME_DIR=/run/play3-airplay-%i
RuntimeDirectoryMode=0700
WorkingDirectory=/opt/play3-airplay
EnvironmentFile=/etc/play3-airplay/players/%i/relay.env
Environment=DIDL_PUSH=0
Environment=FLUSH_RESYNC=0
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u /opt/play3-airplay/play3-relay.py
Nice=10
MemoryMax=110M
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
Restart=on-failure
RestartSec=3
